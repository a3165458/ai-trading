# --- this-that / Jev OpenAI-compatible endpoint ---
# Leave OPENAI_BASE_URL empty to use the built-in mock model.
# this-that-model server:
#   pip install "thisthat @ git+https://github.com/FLock-io/this-that-model"
#   python -m thisthat.server --port 8000
# Then:
# OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_API_KEY=not-needed
# OPENAI_MODEL=flock-io/this-that-model-1.0
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=flock-io/this-that-model-1.0

# --- Lighter.xyz ---
# mainnet: https://mainnet.zklighter.elliot.ai
# testnet: https://testnet.zklighter.elliot.ai
LIGHTER_BASE_URL=https://mainnet.zklighter.elliot.ai
# paper (default) never signs. live requires the three fields below.
TRADING_MODE=paper
LIGHTER_API_PRIVATE_KEY=
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=2

# --- strategy ---
MARKETS=BTC,ETH
LOOP_SECONDS=20
TRADE_NOTIONAL_USD=25
MIN_CONFIDENCE=0.58
MAX_POSITION_USD=200
SLIPPAGE=0.005
PAPER_EQUITY_USD=10000
COOLDOWN_SECONDS=30
ALLOW_FLIP=true

# --- web ---
HOST=0.0.0.0
PORT=3000
