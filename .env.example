# --- decision model ---
# auto | thisthat | jev | mock
# auto: JEV_API_KEY -> hosted Jev; OPENAI_BASE_URL -> local this-that; else mock
MODEL=thisthat

# Local this-that-model (OpenAI-compatible typed decisions)
#   D:\this-that-model\start_server.ps1
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=not-needed
OPENAI_MODEL=flock-io/this-that-model-1.0

# Hosted Jev (https://api.typesafe.ai/v1/systemone)
# MODEL=jev
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_API_KEY=
JEV_MODEL=jev-1.13.0

# --- Lighter.xyz ---
# mainnet: https://mainnet.zklighter.elliot.ai
# testnet: https://testnet.zklighter.elliot.ai
LIGHTER_BASE_URL=https://mainnet.zklighter.elliot.ai
# paper (default) never signs. live requires the three fields below.
TRADING_MODE=paper
LIGHTER_API_PRIVATE_KEY=
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=2

# --- strategy ---
MARKETS=BTC,ETH
# 0 = 连续决策，不按固定秒数等待
LOOP_SECONDS=0
TRADE_NOTIONAL_USD=25
MIN_CONFIDENCE=0.58
# 0 or empty = no cap
MAX_POSITION_USD=0
SLIPPAGE=0.005
PAPER_EQUITY_USD=10000
# 0 = 每轮都可以下单
COOLDOWN_SECONDS=0
ALLOW_FLIP=true

# --- buy / sell / hold 策略层（代码执行，不靠模型自觉） ---
# 空仓开仓要求 p(buy)-p(sell) 的差值至少这么多
EDGE_MIN=0.10
# 模型给 hold 的概率 ≥ 此值时，空仓一律观望
HOLD_MAX=0.60
# 同向信号是否加仓。每次加一笔 TRADE_NOTIONAL_USD
ALLOW_ADD=true
# 开仓之后最多再加几笔（2 = 单标的最多 3 笔）
MAX_ADDS=2
# 同一标的两次下单至少间隔多少秒才允许加仓
ADD_COOLDOWN_SECONDS=120
# 持仓浮盈至少多少 bps 才加仓。0 = 不给亏损仓位补仓；负数 = 允许摊平
ADD_MIN_PNL_BPS=0
# 止损 / 止盈 / 最长持仓，单位 bps 与秒，0 = 关闭
STOP_LOSS_BPS=80
TAKE_PROFIT_BPS=160
MAX_HOLD_SECONDS=1800
# 单边手续费 bps，写进 state 让模型知道往返成本
FEE_BPS=2
# 去偏：仍记录模型长期分布，但不再用它决定方向
DEBIAS=true
DEBIAS_STRENGTH=0.5
# 方向分绝对值达到此值才开仓或反向平仓。盘口单项封顶 6，所以单靠盘口过不了 8
DIR_MIN=8
# 模型对「相反方向」的原始概率 ≥ 此值时，否决这次开仓/平仓。0 = 关闭否决
MODEL_VETO=0.55

# --- web ---
HOST=127.0.0.1
PORT=3000
